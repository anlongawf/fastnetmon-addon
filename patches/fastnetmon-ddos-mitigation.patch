diff --git a/src/fastnetmon.conf b/src/fastnetmon.conf
index 5c737ac2..13df16e5 100644
--- a/src/fastnetmon.conf
+++ b/src/fastnetmon.conf
@@ -376,6 +376,46 @@ prometheus_port = 9209
 # Prometheus host
 prometheus_host = 127.0.0.1
 
+###
+### DDoS Active Mitigation
+###
+
+# Master switch for active DDoS mitigation (blocks/rate-limits attacking IPs directly)
+ddos_mitigation = off
+
+# Mitigation mode: block, ratelimit, block_and_ratelimit
+# block - drop all traffic from attacker (XDP + firewall)
+# ratelimit - only rate limit attacker traffic
+# block_and_ratelimit - apply both block and rate limit rules
+ddos_mitigation_mode = block
+
+# XDP/eBPF based firewall - drops packets at driver level (highest performance)
+# Requires Linux kernel 5.x+ and libbpf
+ddos_mitigation_xdp_firewall = off
+
+# Interface to attach XDP firewall program
+ddos_mitigation_xdp_interface = eth0
+
+# Path to compiled XDP firewall BPF object
+ddos_mitigation_xdp_microcode_path = /etc/xdp_firewall_kernel.o
+
+# XDP-level per-IP rate limiting (applied in kernel, very fast)
+ddos_mitigation_xdp_ratelimit = off
+ddos_mitigation_xdp_ratelimit_pps = 50000
+
+# nftables/iptables based firewall rules
+ddos_mitigation_firewall = off
+
+# Firewall backend: nftables or iptables
+ddos_mitigation_firewall_backend = nftables
+
+# Rate limiting via nftables/iptables (applied per banned IP)
+ddos_mitigation_ratelimit = off
+
+# Rate limit thresholds applied when attack detected
+ddos_mitigation_ratelimit_pps = 10000
+ddos_mitigation_ratelimit_mbps = 500
+
 ###
 ### Client configuration
 ###
