@@ -1180,6 +1182,72 @@ bool load_configuration_file() {
         DEBUG_DUMP_OTHER_PACKETS = configuration_map["dump_other_traffic"] == "on" ? true : false;
     }
 
+    // DDoS Active Mitigation configuration
+    {
+        ddos_mitigation_config_t mitigation_config;
+
+        if (configuration_map.count("ddos_mitigation") != 0) {
+            mitigation_config.enabled = configuration_map["ddos_mitigation"] == "on";
+        }
+
+        if (configuration_map.count("ddos_mitigation_xdp_firewall") != 0) {
+            mitigation_config.xdp_firewall_enabled = configuration_map["ddos_mitigation_xdp_firewall"] == "on";
+        }
+
+        if (configuration_map.count("ddos_mitigation_xdp_interface") != 0) {
+            mitigation_config.xdp_firewall_interface = configuration_map["ddos_mitigation_xdp_interface"];
+        }
+
+        if (configuration_map.count("ddos_mitigation_xdp_microcode_path") != 0) {
+            mitigation_config.xdp_firewall_microcode_path = configuration_map["ddos_mitigation_xdp_microcode_path"];
+        } else {
+            mitigation_config.xdp_firewall_microcode_path = "/etc/xdp_firewall_kernel.o";
+        }
+
+        if (configuration_map.count("ddos_mitigation_firewall") != 0) {
+            mitigation_config.firewall_enabled = configuration_map["ddos_mitigation_firewall"] == "on";
+        }
+
+        if (configuration_map.count("ddos_mitigation_firewall_backend") != 0) {
+            mitigation_config.use_nftables = configuration_map["ddos_mitigation_firewall_backend"] == "nftables";
+        }
+
+        if (configuration_map.count("ddos_mitigation_ratelimit") != 0) {
+            mitigation_config.ratelimit_enabled = configuration_map["ddos_mitigation_ratelimit"] == "on";
+        }
+
+        if (configuration_map.count("ddos_mitigation_ratelimit_pps") != 0) {
+            mitigation_config.ratelimit_pps = convert_string_to_integer(configuration_map["ddos_mitigation_ratelimit_pps"]);
+        }
+
+        if (configuration_map.count("ddos_mitigation_ratelimit_mbps") != 0) {
+            mitigation_config.ratelimit_mbps = convert_string_to_integer(configuration_map["ddos_mitigation_ratelimit_mbps"]);
+        }
+
+        if (configuration_map.count("ddos_mitigation_xdp_ratelimit") != 0) {
+            mitigation_config.xdp_ratelimit_enabled = configuration_map["ddos_mitigation_xdp_ratelimit"] == "on";
+        }
+
+        if (configuration_map.count("ddos_mitigation_xdp_ratelimit_pps") != 0) {
+            mitigation_config.xdp_ratelimit_pps = convert_string_to_integer(configuration_map["ddos_mitigation_xdp_ratelimit_pps"]);
+        }
+
+        if (configuration_map.count("ddos_mitigation_mode") != 0) {
+            std::string mode = configuration_map["ddos_mitigation_mode"];
+            if (mode == "block") {
+                mitigation_config.mode = ddos_mitigation_mode_t::block_only;
+            } else if (mode == "ratelimit") {
+                mitigation_config.mode = ddos_mitigation_mode_t::ratelimit_only;
+            } else if (mode == "block_and_ratelimit") {
+                mitigation_config.mode = ddos_mitigation_mode_t::block_and_ratelimit;
+            }
+        }
+
+        if (mitigation_config.enabled) {
+            ddos_mitigation_init(mitigation_config);
+        }
+    }
+
     return true;
 }
 
